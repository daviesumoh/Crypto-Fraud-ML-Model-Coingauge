# CoinGauge Environment Configuration
# Place your Alchemy API key or QuickNode RPC URLs here.

# Alchemy API Key (enables high-throughput live streaming for Ethereum & Base)
ALCHEMY_API_KEY=

# Or custom QuickNode / Private RPC URLs:
ETHEREUM_RPC_URL=
BASE_RPC_URL=

# Port bindings & persistence
SENTINEL_GATEWAY_ADDR=0.0.0.0:8090
SENTINEL_ML_SERVICE_URL=http://127.0.0.1:8091
COINGAUGE_DATA_DIR=data
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
PORT=3001

